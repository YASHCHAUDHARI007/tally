
{
  "entities": {
    "Employee": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Employee",
      "type": "object",
      "description": "Represents an employee in the system with role-based access.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Employee entity (should be Firebase Auth UID)."
        },
        "username": {
          "type": "string",
          "description": "Employee's username."
        },
        "email": {
            "type": "string",
            "description": "Employee's email for login."
        },
        "role": {
          "type": "string",
          "description": "Employee's role (Admin, Sales, Store)."
        }
      },
      "required": [
        "id",
        "username",
        "email",
        "role"
      ]
    },
    "StockItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "StockItem",
      "type": "object",
      "description": "Represents a stock item.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the StockItem entity."
        },
        "barcode": {
          "type": "string",
          "description": "Barcode of the stock item."
        },
        "name": {
          "type": "string",
          "description": "Name of the stock item."
        },
        "quantity": {
          "type": "number",
          "description": "Available quantity of the stock item."
        },
        "rate": {
          "type": "number",
          "description": "Rate of the stock item."
        },
        "gst": {
          "type": "number",
          "description": "GST applicable to the stock item."
        },
        "category": {
            "type": "string",
            "description": "Category of the stock item."
        },
        "warehouse": {
            "type": "string",
            "description": "Warehouse location of the item."
        }
      },
      "required": [
        "id",
        "barcode",
        "name",
        "quantity",
        "rate",
        "gst"
      ]
    },
    "Receipt": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Receipt",
      "type": "object",
      "description": "Represents a receipt or invoice generated in the system.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Receipt entity."
        },
        "employeeId": {
          "type": "string",
          "description": "Reference to Employee (Firebase Auth UID)."
        },
        "customerName": {
            "type": "string",
            "description": "The name of the customer."
        },
        "date": {
          "type": "string",
          "description": "Date of the receipt (ISO 8601 format).",
          "format": "date-time"
        },
        "items": {
          "type": "array",
          "description": "List of items in the receipt.",
          "items": {
            "type": "object",
            "properties": {
                "itemId": {"type": "string"},
                "quantity": {"type": "number"},
                "rate": {"type": "number"},
                "gst": {"type": "number"}
            },
            "required": ["itemId", "quantity", "rate"]
          }
        },
        "totalAmount": {
          "type": "number",
          "description": "Total amount of the receipt."
        },
        "status": {
            "type": "string",
            "enum": ["Paid", "Pending", "Overdue"]
        }
      },
      "required": [
        "id",
        "employeeId",
        "date",
        "totalAmount",
        "customerName",
        "items",
        "status"
      ]
    },
    "ActivityLog": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ActivityLog",
      "type": "object",
      "description": "Represents a log of user activities in the system.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the ActivityLog entity."
        },
        "employeeId": {
          "type": "string",
          "description": "Reference to Employee (Firebase Auth UID)."
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp of the activity (ISO 8601 format).",
          "format": "date-time"
        },
        "action": {
          "type": "string",
          "description": "Type of action performed."
        },
        "details": {
            "type": "string",
            "description": "Details about the action performed."
        },
        "user": {
            "type": "object",
            "properties": {
                "name": {"type": "string"},
                "role": {"type": "string"}
            }
        }
      },
      "required": [
        "id",
        "employeeId",
        "timestamp",
        "action",
        "details",
        "user"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/employees/{employeeId}": {
      "schema": { "$ref": "#/entities/Employee" },
      "description": "Stores employee data, including role. Employs path-based ownership for simplified security rules."
    },
    "/stockItems/{stockItemId}": {
      "schema": { "$ref": "#/entities/StockItem" },
      "description": "Stores stock item data."
    },
    "/users/{employeeId}/receipts/{receiptId}": {
      "schema": { "$ref": "#/entities/Receipt" },
      "description": "Stores receipts created by employees. Path-based ownership is enforced."
    },
    "/users/{employeeId}/activityLogs/{activityLogId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Stores activity logs for each employee."
    }
  }
}
